# Auto detect text files and perform LF normalization
* text=auto eol=lf

# C# and .NET
*.cs text diff=csharp eol=lf
*.razor text eol=lf
*.cshtml text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf

# Web and Config
*.json text eol=lf
*.xml text eol=lf
*.config text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.env text eol=lf
*.example text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
Jenkinsfile* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.mailmap text eol=lf

# Windows specific scripts & solution files
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.dll binary
*.exe binary
*.pdb binary
*.db binary
*.sqlite binary
