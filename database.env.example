# MariaDB / MySQL Configuration Template
# Copy this file to 'database.env' and set your own passwords before running docker-compose

MYSQL_ROOT_PASSWORD=supersecretroot
MYSQL_DATABASE=risedb
MYSQL_USER=riseuser
MYSQL_PASSWORD=risepassword
MYSQL_DNS_LOCATION=rise-db

# Server Connection String (evaluated in container)
DatabaseConnection=server=${MYSQL_DNS_LOCATION};user=${MYSQL_USER};password=${MYSQL_PASSWORD};database=${MYSQL_DATABASE};TreatTinyAsBoolean=false;
