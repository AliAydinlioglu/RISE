@page "/school-events"

@using Rise.Client.Components
@using Rise.Client.Components.Calendar
@using Rise.Client.Components.Card

<PageTitle>Evenementen</PageTitle>

<div class="container">
    <RiseHeadTitle>Evenementen</RiseHeadTitle>
</div>

<section class="mt-5 container school-events">
    @if (_schoolEvents == null)
    {
        <MudContainer Class="mt-8">
            <RiseLoader />
        </MudContainer>
    }
    else
    {
        <MudGrid>
            
            <MudItem lg="4" Class="is-hidden-mobile">
                <MudIconButton
                    Icon="@Icons.Material.Outlined.CalendarToday"
                    Variant="Variant.Filled"
                    Size="Size.Medium"
                    Color="Color.Primary"/>
                <MudIconButton
                    Icon="@Icons.Material.Outlined.List"
                    Variant="Variant.Outlined"
                    Size="Size.Medium"
                    Color="Color.Primary"/>
            </MudItem>
            
            <MudItem lg="4" Class="d-flex align-center justify-center">
                <WeekCalendar 
                    SelectedDate="SelectedDate"
                    SelectedDateChanged="EventCallback.Factory.Create<DateTime>(this, date => SelectedDate = date)"
                    Title="@($"{SelectedDate:MMMM yyyy}")"
                    OnPreviousWeek="() => SetDateRelativeToCurrentDate(-7)"
                    OnNextWeek="() => SetDateRelativeToCurrentDate(7)"/>
            </MudItem>
            
            <MudItem lg="4" Class="d-flex flex-column">
                <MudMenu 
                    Class="align-self-end"
                    Icon="@Icons.Material.Outlined.FilterAlt"
                    Variant="Variant.Outlined"
                    Size="Size.Medium"
                    Color="Color.Primary"
                    Style="width: fit-content; margin-bottom: 0.25rem"
                >
                    <MudMenuItem OnClick="() => { }">Categorie</MudMenuItem>
                    <MudMenuItem OnClick="() => { }">Prijs</MudMenuItem>
                    <MudMenuItem OnClick="() => { }">Campus</MudMenuItem>
                </MudMenu>
                <MudMenu
                    Class="is-hidden-mobile align-self-end"
                    Icon="@Icons.Material.Outlined.Sort"
                    Variant="Variant.Outlined"
                    Size="Size.Medium"
                    Color="Color.Primary"
                    Style="width: fit-content">
                    <MudMenuItem OnClick="() => { }">Naam</MudMenuItem>
                    <MudMenuItem OnClick="() => { }">Categorie</MudMenuItem>
                    <MudMenuItem OnClick="() => { }">Datum</MudMenuItem>
                    <MudMenuItem OnClick="() => { }">Campus</MudMenuItem>
                </MudMenu>
            </MudItem>
            
        </MudGrid>
        
        <div class="is-flex columns  is-multiline  mb-4">
            @foreach (var schoolEvent in _schoolEvents)
            {
                <article data-bunit="sa-index" class="mb-4 column  is-12-mobile is-6-tablet is-3-desktop ">
                
                    <a href="/school-events/@schoolEvent.Id">
                        <!-- Desktop/Tablet: Vertical Card -->
                        <div class="is-hidden-mobile">
                            <RiseVerticalCard Date="schoolEvent.Date.LocalDateTime" Title="@schoolEvent.Title">
                                <RiseSchoolEventCardContent 
                                    Category="@schoolEvent.Category"
                                    StartTime="@schoolEvent.StartTime"
                                    EndTime="@schoolEvent.EndTime"
                                    Location="@schoolEvent.Location"
                                    Date="@schoolEvent.Date.LocalDateTime"/>
                            </RiseVerticalCard>
                        </div>

                        <!-- Mobile: Regular Card -->
                        <div class="is-hidden-tablet">
                            <RiseCard Date="schoolEvent.Date.LocalDateTime" Title="@schoolEvent.Title">
                                <RiseSchoolEventCardContent 
                                    Category="@schoolEvent.Category"
                                    StartTime="@schoolEvent.StartTime"
                                    EndTime="@schoolEvent.EndTime"
                                    Location="@schoolEvent.Location"
                                    Date="@schoolEvent.Date.LocalDateTime"/>
                            </RiseCard>
                        </div>
                    </a>
                </article>
            }
        </div>
        <section class="section pagination-section"> 
            <nav class="pagination is-rounded is-centered" role="navigation">
                
                <button class="pagination-previous"
                        disabled="@(_currentPage <= 1)"
                        @onclick="() => OnPageChangedAsync(_currentPage - 1)">
                    Previous
                </button>
                <button class="pagination-next"
                        disabled="@(_currentPage >= TotalPages)"
                        @onclick="() => OnPageChangedAsync(_currentPage + 1)">
                    Next
                </button>
                
                <ul class="pagination-list">
                    @for (var i = 1; i <= TotalPages; i++)
                    {
                        var pageNumber = i;
                        <li>
                            <button class="pagination-link @(_currentPage == pageNumber ? "is-current" : "")"
                                    @onclick="() => OnPageChangedAsync(pageNumber)">
                                @pageNumber
                            </button>
                        </li>
                    }
                </ul>
                
            </nav>
        </section>
    }
</section>