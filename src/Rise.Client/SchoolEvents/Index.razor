@page "/school-events"

@using Rise.Client.Components
@using Rise.Client.Components.Card

<PageTitle>Evenementen</PageTitle>
<div class="container ">
    <RiseHeadTitle>Evenementen</RiseHeadTitle>
</div>
<section class="mt-5 container school-events">
    @if (schoolEvents == null)
    {
        <MudContainer Class="mt-8">
            <RiseLoader />
        </MudContainer>
    }
    else
    {
        <div class="is-flex columns  is-multiline  mb-4">
            
            @foreach (var schoolEvent in schoolEvents)
            {
           
                <article data-bunit="sa-index" class="mb-4 column  is-12-mobile is-6-tablet is-3-desktop ">
                
                    <a href="/school-event/@schoolEvent.Id">
                        <!-- Desktop/Tablet: Vertical Card -->
                        <div class="is-hidden-mobile">
                            <RiseVerticalCard Date="schoolEvent.Date.LocalDateTime" Title="@schoolEvent.Title">
                                @*TODO*@
                            </RiseVerticalCard>
                        </div>

                        <!-- Mobile: Regular Card -->
                        <div class="is-hidden-tablet">
                            <RiseCard Date="schoolEvent.Date.LocalDateTime" Title="@schoolEvent.Title">
                                @*TODO*@
                            </RiseCard>
                        </div>
                    </a>
                </article>
            }
        
        </div>
        <section class="section pagination-section"> 
        
            <nav class="pagination is-rounded is-centered" role="navigation">
                <button class="pagination-previous" 
                        disabled="@(currentPage <= 1)"
                        @onclick="() => OnPageChangedAsync(currentPage - 1)">
                    Previous
                </button>
                <button class="pagination-next" 
                        disabled="@(currentPage >= totalPages)"
                        @onclick="() => OnPageChangedAsync(currentPage + 1)">
                    Next
                </button>
                <ul class="pagination-list">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        var pageNumber = i;
                        <li>
                            <button class="pagination-link @(currentPage == pageNumber ? "is-current" : "")"
                                    @onclick="() => OnPageChangedAsync(pageNumber)">
                                @pageNumber
                            </button>
                        </li>
                    }
                </ul>
            </nav>
        </section>
        }
</section>