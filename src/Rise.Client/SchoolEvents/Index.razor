@page "/school-events"
@using Rise.Client.Components.Calendar

<PageTitle>Evenementen</PageTitle>

<div class="container">
    <RiseHeadTitle>Evenementen</RiseHeadTitle>
</div>

<section class="mt-5 container school-events">
    @if (_schoolEvents == null)
    {
        <MudContainer Class="mt-8">
            <RiseLoader />
        </MudContainer>
    }
    else
    {
        <div style="display: flex; justify-content: center; margin: auto 0;">
            <RiseWeekCalendar
                SelectedDate="_selectedDate"
                SelectedDateChanged="(date) => OnDateChangedAsync(date)"
                Title="@($"{_selectedDate:MMMM yyyy}")"
                CalendarType="RiseWeekCalendar.RiseWeekCalendarType.Secondary"
                CalendarWidth="RiseWeekCalendar.RiseWeekCalendarWidth.Medium"
                ShowOnlySchoolDays="false"
                OnPreviousWeek="() => SetDateRelativeToCurrentDateAsync(-7)"
                OnNextWeek="() => SetDateRelativeToCurrentDateAsync(7)"/>
        </div>
        
        if (!_schoolEvents.Any())
        {
            <div data-bunit="se-no-events-message" class="notification is-light">
                <p class="has-text-centered">Geen evenementen voor deze dag.</p>
            </div>
        }
        else
        {
            <div class="is-flex columns  is-multiline  mb-4">
                @foreach (var schoolEvent in _schoolEvents)
                {
                    <article data-bunit="se-index-card" class="mb-4 column is-12-mobile is-6-tablet is-3-desktop ">
                
                        <a href="/school-events/@schoolEvent.Id">
                            <!-- Desktop/Tablet: Vertical Card -->
                            <div class="is-hidden-mobile">
                                <RiseVerticalCard Date="schoolEvent.Date.LocalDateTime" Title="@schoolEvent.Title" ImageUrl="@schoolEvent.ImageUrl">
                                    <RiseSchoolEventCardContent 
                                        Category="@schoolEvent.Category"
                                        StartTime="@schoolEvent.StartTime"
                                        EndTime="@schoolEvent.EndTime"
                                        Location="@schoolEvent.Location"
                                        Date="@schoolEvent.Date.LocalDateTime"/>
                                </RiseVerticalCard>
                            </div>

                            <!-- Mobile: Regular Card -->
                            <div class="is-hidden-tablet">
                                <RiseCard Date="schoolEvent.Date.LocalDateTime" Title="@schoolEvent.Title" ImageUrl="@schoolEvent.ImageUrl">
                                    <RiseSchoolEventCardContent 
                                        Category="@schoolEvent.Category"
                                        StartTime="@schoolEvent.StartTime"
                                        EndTime="@schoolEvent.EndTime"
                                        Location="@schoolEvent.Location"
                                        Date="@schoolEvent.Date.LocalDateTime"/>
                                </RiseCard>
                            </div>
                        </a>
                    </article>
                }
            </div>
            
            <RisePagination 
                CurrentPage="_currentPage" 
                PageSize="PageSize"
                TotalPages="TotalPages"
                CurrentPageChanged="OnPageChangedAsync"/>
        }
    }
</section>