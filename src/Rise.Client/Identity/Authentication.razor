@page "/authentication/{action}"
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Rise.Client.Components

@if (showError)
{
    <div class="error-overlay">
        <div class="notification-container">
            <Notification Title="Login mislukt"
                          Subtitle="Er is een fout opgetreden tijdens het inloggen"
                          Severity="Notification.NotificationSeverity.Error">
                @errorMessage
            </Notification>
            <p class="redirect-message">U wordt automatisch uitgelogd en doorgestuurd naar de login pagina...</p>
        </div>
    </div>
}

<RemoteAuthenticatorView Action="@Action"
                         OnLogInSucceeded="OnLoginSucceeded"
                         OnLogOutSucceeded="OnLogoutSucceeded">
    <LoggingIn>
        <div class="auth-message">
            <p>Inloggen...</p>
        </div>
    </LoggingIn>
    <CompletingLoggingIn>
        <div class="auth-message">
            <p>Login wordt voltooid...</p>
        </div>
    </CompletingLoggingIn>
    <CompletingLogOut>
        <div class="auth-message">
            <p>Uitloggen...</p>
        </div>
    </CompletingLogOut>
</RemoteAuthenticatorView>