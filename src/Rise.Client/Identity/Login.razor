@page "/login"
@using Rise.Client.Components
@using Rise.Client.Components.Form
@using static Rise.Client.Components.RiseButton
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Login</PageTitle>

<AuthorizeView>
    <Authorized Context="authContext">
    </Authorized>

    <NotAuthorized>
        <div class="login" @onkeydown="HandleKeyDown">
            <div class="login-bg" style='background-image: url("/img/HOGENT_bg@(randomNumber).jpg");'></div>
            <div class="login-overlay"></div>
            <div class="login-center">               
                <section class="login-box">
                    <EditForm Model="Model" OnValidSubmit="HandleLogin" Context="formContext">
                        <div class="button-field">
                            <RiseButton @ref="loginButtonRef"
                                        OnClick="HandleLogin"
                                        Size="RiseButtonSize.XLarge"
                                        Type="RiseButtonType.Primary">
                                AANMELDEN
                            </RiseButton>
                        </div>
                    </EditForm>
                </section>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>