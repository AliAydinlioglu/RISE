@page "/StudentActivities/{Id?}"
@using Rise.Client.Components

<div class="container is-widescreen">
<HeadTitle>@Title</HeadTitle>

<section class="section">
    
    <p><b>Organisator:</b> @StudentClubName</p>
    <table>

        <tr>
            <td rowspan="2" class="mr-2"><b>Datum:</b></td>
            <td>@LocalDateString</td>
        </tr>
        <tr>
            <td>@TimeString</td>
        </tr>
        <tr>
            <td rowspan="2" class="mr-2"><b>Locatie:</b></td>
            <td>@LocationName</td>
        </tr>
        <tr>
            <td>@Address</td>
        </tr>
    </table>

    <p>
        <b>Beschrijving:</b><br/>
        @Description
    </p>
</section>
</div>