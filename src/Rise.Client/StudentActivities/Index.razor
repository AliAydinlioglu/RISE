@page "/student-activities"


<PageTitle>Studenten Activiteiten</PageTitle>
<div class="container ">
    <RiseHeadTitle ImageUrl="/img/banner35.webp">Studenten activiteiten</RiseHeadTitle>
</div>
<section class="mt-5 container student-activities">
    @if (studentActivities == null)
    {
        <MudContainer Class="mt-8">
            <RiseLoader/>
        </MudContainer>
    }
    else
    {
        <div class="is-flex columns  is-multiline  mb-4">

            @foreach (var studentActivity in studentActivities)
            {
                <article data-bunit="sa-index" class="mb-4 column  is-12-mobile is-6-tablet is-3-desktop ">

                    <a href="/student-activities/@studentActivity.Id">
                        <!-- Desktop/Tablet: Vertical Card -->
                        <div class="is-hidden-mobile">
                            <RiseVerticalCard Date="studentActivity.Date.LocalDateTime" Title="@studentActivity.Title"
                                              ImageUrl="@studentActivity.ImageUrl">
                                <RiseStudentActivitiesCardContent StudentClubName="@studentActivity.StudentClub.Name"
                                                                  Date="studentActivity.Date.LocalDateTime"
                                                                  StartTime="studentActivity.StartTime"
                                                                  EndTime="studentActivity.EndTime"
                                                                  Location="studentActivity.Location"/>
                            </RiseVerticalCard>
                        </div>

                        <!-- Mobile: Regular Card -->
                        <div class="is-hidden-tablet">
                            <RiseCard Date="studentActivity.Date.LocalDateTime" Title="@studentActivity.Title"
                                      ImageUrl="@studentActivity.ImageUrl">
                                <RiseStudentActivitiesCardContent StudentClubName="@studentActivity.StudentClub.Name"
                                                                  Date="studentActivity.Date.LocalDateTime"
                                                                  StartTime="studentActivity.StartTime"
                                                                  EndTime="studentActivity.EndTime"
                                                                  Location="studentActivity.Location"/>
                            </RiseCard>
                        </div>
                    </a>
                </article>
            }

        </div>
        <RisePagination PageSize="_pageSize" 
                        CurrentPage="_currentPage" 
                        CurrentPageChanged="OnPageChangedAsync"
                        TotalPages="_totalPages"/>
    }
</section>
