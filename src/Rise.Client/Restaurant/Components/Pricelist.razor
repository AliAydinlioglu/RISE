@page "/restaurant/prijslijst"
<div class="pricelist">
    <div class="mb-4">
        <RiseHeadTitle>Prijslijst</RiseHeadTitle>
    </div>
    
    <div class="container">
        <RestaurantNavigationTabs ActiveTab="NavigationTab.Prijslijst"/>
        
        <div class="mb-2">
            <RiseButton OnClick="ToggleRestoSelector" Size="RiseButton.RiseButtonSize.Small" Type="RiseButton.RiseButtonType.Primary">
                @currentResto.Name &nbsp;
                <MudIcon Icon="@Icons.Material.Filled.FilterList"/>
            </RiseButton>
        </div>
        
        <RestaurantFilter @bind-IsVisible="_visible" OnSelect="@ApplyRestoSelection" OnClose="ToggleRestoSelector"/>

        
        <MudExpansionPanels MultiExpansion="true" Class="breakout" Dense="true" Gutters="false" Elevation="0">
            <MudExpansionPanel>
                <TitleContent>
                    <div class="d-flex w-100 px-2">
                        <span class="flex-grow-1">
                            Ontbijt en snacks
                        </span>
                    </div>
                </TitleContent>
                <ChildContent>
                    <table>
                        <col class="fooditem"/>
                        <col span="2" class="prices" />
                        <thead>
                        <tr>
                            <th></th>
                            <th>Studenten</th>
                            <th>Externen</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr>
                            <td>Ontbijtkoek</td>
                            <td>1.20</td>
                            <td>1.65</td>
                        </tr>
                        </tbody>
                    </table>
                </ChildContent>
            </MudExpansionPanel>
            <MudExpansionPanel>
                <TitleContent>
                    <div class="d-flex justify-space-between ">
                        <span>
                            Warme maaltijden
                        </span>
                    </div>
                </TitleContent>
                <ChildContent>
                    Panel Content
                </ChildContent>
            </MudExpansionPanel>
            <MudExpansionPanel Text="Panel Three">
                Panel Three Content
            </MudExpansionPanel>
            <MudExpansionPanel Text="Panel Four">
                Panel Four Content
            </MudExpansionPanel>
        </MudExpansionPanels>
    </div>
</div>