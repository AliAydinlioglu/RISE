<MudOverlay Visible="IsVisible" VisibleChanged="HandleVisibilityChange" Class="mud-skip-overlay-section" @onclick:stopPropagation="true" AutoClose="true" DarkBackground="true">
    <div class="resto-selector @(IsVisible ? "visible" : "")"  @onclick:stopPropagation="true">
        <div class="resto-selector-header">
            <p class="is-hidden-tablet"> &#8592; Terug</p>
            <h3>Kies een restaurant</h3>
        </div>
        <div class="resto-selector-content is-flex is-flex-direction-column gap-2">
            @foreach(var resto in Restaurants)
            {
                <RiseButton OnClick="() => OnRestaurantSelect(resto)"> @resto.Name</RiseButton>
            }
        </div>
    </div>
</MudOverlay>