@if (IsError)
{
    <RiseNotification Severity="Error"
                      Title="Fout">Er ging iets mis met het ophalen van deze informatie! Probeer later opnieuw
    </RiseNotification>
}
else if (IsLoading)
{
    <MudContainer Class="mt-8">
        <RiseLoader/>
    </MudContainer>
}
else
{
    @ChildContent
}