<div class="sidebar-container">
    <!-- Hamburger Button-->
    @if (!_isOpen)
    {
        <button class="hamburger-btn" @onclick="ToggleSidebar">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>
    }

    <!-- Side Navigation -->
    <nav class="side-navbar @(_isOpen ? "open" : "")">
        <div class="sidebar-header">
            <div class="sidebar-header-content">
                <h2 class="sidebar-title">@GetCurrentPageName()</h2>
            </div>
        </div>

        <ul class="sidebar-menu">
            <li class="sidebar-menu-item">
                <a href="/" class="sidebar-link" @onclick="CloseSidebar">Home</a>
            </li>
            <li class="sidebar-menu-item">
                <a href="/nieuws" class="sidebar-link" @onclick="CloseSidebar">Nieuws</a>
            </li>
            <li class="sidebar-menu-item">
                <a href="/kalender" class="sidebar-link" @onclick="CloseSidebar">Kalender</a>
            </li>
            <li class="sidebar-menu-item">
                <a href="/vakken" class="sidebar-link" @onclick="CloseSidebar">Vakken</a>
            </li>
            <li class="sidebar-menu-item">
                <a href="/studentenleven" class="sidebar-link" @onclick="CloseSidebar">Studentenleven</a>
            </li>
            <li class="sidebar-menu-item">
                <a href="/campus" class="sidebar-link" @onclick="CloseSidebar">Campus</a>
            </li>
            <li class="sidebar-menu-item">
                <a href="/contact" class="sidebar-link" @onclick="CloseSidebar">Contact</a>
            </li>
        </ul>
    </nav>

    <!-- Overlay -->
    @if (_isOpen)
    {
        <div class="sidebar-overlay" @onclick="ToggleSidebar"></div>
    }
</div>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    
    private bool _isOpen;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _isOpen = false;
        StateHasChanged();
    }

    private void ToggleSidebar()
    {
        _isOpen = !_isOpen;
    }

    private void CloseSidebar()
    {
        _isOpen = false;
    }

    private string GetCurrentPageName()
    {
        var uri = new Uri(NavigationManager.Uri);
        var path = uri.AbsolutePath.TrimStart('/');
        
        if (string.IsNullOrEmpty(path) || path == "/")
            return "Home";
        
        return path switch
        {
            "nieuws" => "Nieuws",
            "kalender" => "Kalender",
            "vakken" => "Vakken",
            "studentenleven" => "Studentenleven",
            "campus" => "Campus",
            "contact" => "Contact",
            _ => "Campus App"
        };
    }
}
