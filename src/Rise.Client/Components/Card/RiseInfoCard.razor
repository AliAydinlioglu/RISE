<div class="info-card box p-0">
    <div class="info-card-header is-flex is-align-items-center is-justify-content-center"
         loading="lazy"
         style="background-image: url('img/banner@(randomIndex.Next(0, 131)).webp');">
        <h2 class="title is-4 has-text-white m-0" style="color: var(--mud-palette-color-secondary)">@Title</h2>
    </div>

    <div class="info-card-content p-4">
        @ChildContent
    </div>
</div>
    