@using System.Globalization
@namespace Rise.Client.Components.Card

<div @onclick="HandleClick"
     class="box is-flex p-0 is-align-items-stretch @Class"
     style="--scale: @ScaleString; @(OnClickNavigateTo is null ? null : "cursor: pointer;")">
    <div class="stacking-container scalable">
        @* BACKGROUND - Image or Title Initials *@
        @if (!string.IsNullOrEmpty(ImageUrl) && ShowImage && !ThemingService.ImagesOff)
        {
            <!-- Image background -->
            <div class="square stacking-container-background stacking-container-image">
                <img src="@ImageUrl" alt="@Title" class="background-image" />
            </div>
        }
        else
        {
            <!-- Text background -->
            <div class="square stacking-container-background is-flex is-flex-direction-column is-justify-content-center is-align-items-center">
                <p>@BackgroundTitle</p>
            </div>
        }

        @* FOREGROUND - Date (always visible) *@
        <div class="square stacking-container-foreground mr-3">
            <div class="inner-date-square is-flex is-flex-direction-column is-justify-content-center is-align-items-center">
                <p class="day-of-month-label has-text-weight-bold m-0">@DayOfMonth</p>
                <p class="month-abbr-label has-text-weight-bold is-uppercase m-0">@MonthAbbreviation</p>
            </div>
        </div>
    </div>
    <div class="course-info py-2">
        <p class="header-label card-header has-text-weight-light mb-1">@CardHeader</p>
        <p class="title-label has-text-weight-semibold mb-0">@Title</p>
        <p class="description-label m-0">@Description</p>

        @ChildContent
    </div>
</div>