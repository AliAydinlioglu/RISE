@inherits RiseCard

<div class="card vertical-card">
    <div class="stacking-container">
        <div class="stacking-container-background"
             style="@(!string.IsNullOrEmpty(ImageUrl) ? $"background-image: url('{ImageUrl}'); background-size: cover; background-position: center;" : "")">
            @* BACKGROUND *@
            @if (!string.IsNullOrEmpty(ImageUrl))
            {
                <div class="vertical-card-image-overlay"></div>
            }
        </div>
        
        @* FOREGROUND *@
        <div class="square stacking-container-foreground mr-3">
            <div
                class="inner-date-square is-flex is-flex-direction-column is-justify-content-center is-align-items-center" style="color: var(--mud-palette-text-secondary)">
                <p class="has-text-weight-bold is-size-1 m-0">@DayOfMonth</p>
                <p class="has-text-weight-bold is-size-3 is-uppercase m-0">@MonthAbbreviation</p>
            </div>
        </div>
    </div>
    <div class="card-content has-border">
        <div class="media">
            <div class="media-content"> 
                <p class="title is-4">@Title</p>
            </div>
        </div>

        <div class="content">
            @ChildContent
        </div>
    </div>
</div>