@inherits RiseCard;

<div class="is-flex is-flex-direction-column is-justify-content-center">
    <p style="white-space: nowrap;overflow: hidden;text-overflow: ellipsis;">@Category</p>
    <p style="white-space: nowrap;overflow: hidden;text-overflow: ellipsis;">@DateString</p>
    <p style="white-space: nowrap;overflow: hidden;text-overflow: ellipsis;">@TimeRangeString</p>
    <p class="is-flex-grow-1" style="white-space: nowrap;overflow: hidden;text-overflow: ellipsis;">@(Location?.GetAddressWithName() ?? "Online")</p>
</div>