<div class="box mb-5 @GetWidthClass()" style="@GetBackgroundColorClass()">
    <div class="has-text-centered mb-4">
        <p class="title is-4 is-capitalized has-text-centered" style="@GetForegroundColorClass()">
            @Title
        </p>
    </div>

    <div class="columns is-mobile is-gapless">
        <button class="button is-ghost pr-3" @onclick="OnPreviousWeek" style="text-decoration: none; @GetForegroundColorClass()">
            <span class="icon is-small">
                <i class="fas fa-chevron-left"></i>
            </span>
        </button>
        
        @foreach (var day in GetSchooldaysOfCurrentWeek())
        {
            var isSelected = day.Date == SelectedDate.Date;
            <div class="column is-flex is-justify-content-center is-align-items-center">
                <button data-bunit="wc-day-button" @onclick="() => OnDateSelected(day)">
                    <div class="has-text-centered" style="@GetForegroundColorClass()">
                        <p class="is-size-7 has-text-weight-semibold is-capitalized mb-2">
                            @day.ToString("ddd")
                        </p>
                        <div class="is-inline-flex is-justify-content-center is-align-items-center"
                             style="width: 2.5rem; height: 2.5rem; border-radius: 50%; @GetBackgroundColorClassWhenSelected(isSelected)">
                            <span data-bunit="calendar-day" class="has-text-weight-bold" style="@GetForegroundColorClassWhenSelected(isSelected)">@day.Day</span>
                        </div>
                    </div>
                </button>
            </div>
        }

        <button class="button is-ghost pl-3" @onclick="OnNextWeek" style="text-decoration: none; @GetForegroundColorClass()">
            <span class="icon is-small">
                <i class="fas fa-chevron-right"></i>
            </span>
        </button>
    </div>
</div>