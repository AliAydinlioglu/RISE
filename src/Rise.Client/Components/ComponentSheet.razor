@code {
    private IEnumerable<CalendarViewItem> GetItemsForSelectedDate()
    {
        var targetDate = DateTime.Today;
        return new List<CalendarViewItem>
        {
            new CalendarViewItem()
            {
                CourseId = "123",
                Type = CalendarViewItem.CalendarEventType.Course,
                Date = targetDate,
                Title = "Mock Event",
                Description = "This is a mock event",
                Header = "Mock Header"
            }
        };
    }

SchoolEventDto.Index _schoolEvent = new SchoolEventDto.Index
{
    Id = 1,
    Title = "Sample School Event",
    Date = DateTimeOffset.Now,
    ImageUrl = "img/school_event.webp",
    Category = "Seminar",
    StartTime = new TimeOnly(10, 0),
    EndTime = new TimeOnly(12, 0),
    Location = new LocationDto.Index
    {
        Id = 1,
        Name = "Auditorium",
        Street = "Campus Street",
        HouseNumber = 100,
        City = "Brussels",
        Postcode = 1000
    },
    Price = 0.0m,  // or whatever default price makes sense
    RegisterLink = string.Empty,  // or a valid URL
    Capacity = 100,  // or your desired capacity
    Registrable = false,  // or true if registration is open
    Publicity = "Public"  // or whatever publicity level is appropriate
};
}