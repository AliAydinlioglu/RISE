@page "/components"
@using Rise.Client.Calendar
@using Rise.Shared.Locations
@using Rise.Shared.SchoolEvents

<RiseCard Title="Component Sheet Demo" Date="@DateTime.Now" >
    <RiseCardContent >
        <MudText Typo="Typo.h5">Component Sheet</MudText>
        <MudText Typo="Typo.body1">
            This is a component sheet demonstrating various UI components.
        </MudText>
    </RiseCardContent>
</RiseCard>

<RiseInfoCard Title="Calendar View">
    <RiseCardContent>
        <MudCalendarView ItemsFunc="GetItemsForSelectedDate" />
    </RiseCardContent>
</RiseInfoCard>

<RiseSchoolEventCardContent ImageUrl="@_schoolEvent.ImageUrl"
                            Category="@_schoolEvent.Category"
                            StartTime="@_schoolEvent.StartTime"
                            EndTime="@_schoolEvent.EndTime"
                            Location="@_schoolEvent.Location"
                            Date="@_schoolEvent.Date.LocalDateTime"></RiseSchoolEventCardContent>

<RiseVerticalCard Date="@_schoolEvent.Date.LocalDateTime" Title="@_schoolEvent.Title">
    <RiseSchoolEventCardContent 
        ImageUrl="@_schoolEvent.ImageUrl"
        Category="@_schoolEvent.Category"
        StartTime="@_schoolEvent.StartTime"
        EndTime="@_schoolEvent.EndTime"
        Location="@_schoolEvent.Location"
        Date="@_schoolEvent.Date.LocalDateTime"/>
</RiseVerticalCard>

<RiseStudentActivitiesCardContent 
    StartTime="@_schoolEvent.StartTime"
        EndTime="@_schoolEvent.EndTime"
        Location="@_schoolEvent.Location"
        StudentClubName="ExampleClub" />


<RiseAppHeader>
    <IconMenu>
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />
    </IconMenu>
    <ProfileSection>
        <MudAvatar Size="Size.Medium" Alt="User Avatar" Src="img/user_avatar.png" />
    </ProfileSection>
</RiseAppHeader>

<RiseButton ButtonType="ButtonType.Submit">Example</RiseButton>

@* <RiseCarousel Items="@Items"></RiseCarousel> *@


