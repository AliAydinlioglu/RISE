<div class="container">
    <label class="input-label">@Label</label>
    <MudTextField 
        T="string"
        @bind-Value="@Value"
        Variant="Variant.Outlined"
        HelperText="@HelperText"
        Disabled="@Disabled"
        Error="@Error"
        ErrorText="@ErrorText"
        Lines="@Lines"
        Class="mb-4"/>
</div>