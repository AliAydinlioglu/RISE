<MudPaper Class="container head-title-container is-hidden-mobile" Elevation="0" Square="true" Style="@BackgroundStyle">
    @if (!string.IsNullOrEmpty(ImageUrl))
    {
        <div class="hero-background-overlay" style="background:@OverlayColor"></div>
    }
    <div class="headtitle-content">
    <MudText Typo="Typo.h3" Align="Align.Center">
        @ChildContent
    </MudText>
    @if (!string.IsNullOrEmpty(SubTitle))
    {
        <MudText Typo="Typo.subtitle2" Align="Align.Center">
            @SubTitle
        </MudText>
    }
    </div>
</MudPaper>
