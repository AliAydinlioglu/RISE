<MudAlert Class="notification-alert"
          Severity="@_notificationProps.Severity"
          Variant="Variant.Filled"
          Icon="@_notificationProps.IconType"
          ShowCloseIcon="false">

    <MudText Typo="Typo.h6">@Title</MudText>

    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <MudText Typo="Typo.subtitle2">@Subtitle</MudText>
    }

    <MudText Typo="Typo.body2">@ChildContent</MudText>
</MudAlert>
