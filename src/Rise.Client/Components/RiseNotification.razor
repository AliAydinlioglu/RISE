<div>
    <MudAlert Severity="@_notificationProps.Severity" Variant="Variant.Filled" Icon="@_notificationProps.IconType">
        <MudText Typo="Typo.h4" Class="semi-bold">@Title</MudText>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <MudText Typo="Typo.subtitle1">@Subtitle</MudText>
        }
        
       <MudText Typo="Typo.body2" > @ChildContent </MudText>
    </MudAlert>
</div>