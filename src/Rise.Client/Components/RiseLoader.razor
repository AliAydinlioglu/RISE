<div data-bunit="loader" class="loader-container @AnimationState">
    @for (var i = 0; i < Letters.Length; i++)
    {
        var position = GetLetterPosition(i);
        <div class="letter-container" style="@GetPositionAnimationStyle(position)">
            <div class="circle" style="background-color: var(--mud-palette-primary);"></div>
            <span class="letter" style="color: var(--mud-palette-primary);">@Letters[i]</span>
        </div>
    }
</div>