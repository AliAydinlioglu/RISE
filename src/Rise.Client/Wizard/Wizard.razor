@page "/wizard"
@using Rise.Client.Calendar
@using Rise.Client.Calendar.Components
@using Rise.Client.Theme

<h3>Wizard</h3>

<CalendarItemsList  Items="@GetItemsForSelectedDate()" EmptyMessage="Geen evenementen voor deze dag"/>

<MudItem xs="6" sm="4" md="3" lg="2">
    <RiseHomeBlock>Voorbeeld</RiseHomeBlock>
</MudItem>

<MudForm @ref="form" @bind-IsValid="@success" FieldChanged="UpdateTheme">
    <MudCard>
        <MudCardContent>
            <MudSwitch @bind-Value="@prefs.DarkMode" Label="Dark Mode" Color="Color.Primary"/>
            <MudSwitch @bind-Value="@prefs.HighContrast" Label="High Contrast" Color="Color.Primary"/>

            <MudSwitch @bind-Value="@prefs.NotificationsEnabled" Label="Enable Notifications" Color="Color.Primary"/>
            <MudSwitch @bind-Value="@prefs.AutoSave" Label="Auto Save" Color="Color.Primary"/>
            <MudSwitch @bind-Value="@prefs.ShowTutorials" Label="Show Tutorials" Color="Color.Primary"/>
        </MudCardContent>
    </MudCard>
</MudForm>

@code {
    private MudForm form = null!;
    private bool success;
    private UserPreferences prefs = new UserPreferences();

    private bool isDarkMode = false;
    
    [Inject]
    private IThemingService themingService { get; set; } = default!;

    private class MudBSwitch : MudSwitch<bool>;

    private class UserPreferences
    {
        public bool DarkMode { get; set; }
        public bool HighContrast { get; set; } = false;
        public bool NotificationsEnabled { get; set; } = true;
        public bool AutoSave { get; set; } = true;
        public bool ShowTutorials { get; set; } = true;
    }


    private void UpdateTheme()
    {
        if (prefs.DarkMode)
        {
            themingService.DarkTheme();
        }
        else
        {
            themingService.LightTheme();
        }
    }
    
    private IEnumerable<CalendarViewItem> GetItemsForSelectedDate()
    {
        var targetDate = DateTime.Today;
        return new List<CalendarViewItem>
        {
            new CalendarViewItem()
            {
                CourseId = "123",
                Type = CalendarViewItem.CalendarEventType.Course,
                Date = targetDate,
                Title = "Mock Event",
                Description = "This is a mock event",
                Header = "Mock Header"
            }
        };
    }
}