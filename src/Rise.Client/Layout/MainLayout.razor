@using Rise.Client.Components
@using Rise.Client.Components.Dropdown
@inherits LayoutComponentBase

@* Required *@
<MudThemeProvider Theme="@MyCustomTheme"/>
<MudPopoverProvider/>
@* Needed for dialogs *@
<MudDialogProvider/>
@* Needed for snackbars *@
<MudSnackbarProvider/>

<MudLayout>
    <RiseAppHeader >
        
        @* TODO: Replace with real menu and login/profile functionality *@
        <IconMenu>
            <MudIcon Icon="@Icons.Material.Rounded.NotificationsNone" Size="Size.Large"/>
        </IconMenu>
        <ProfileSection>
            <RiseNavigationDropdown Items="_profilePages" ItemTextFunc="@(p => p.Title)" NavigationUrlFunc="@(p => p.Url)">
                <ActivatorContent>
                    @* TODO: Replace with user profile image or initials *@
                    <MudAvatar Class="px-1 border-2  " Variant="Variant.Outlined" Color="Color.Secondary">
                        <MudText Typo="Typo.body2">AW</MudText>
                    </MudAvatar>
                </ActivatorContent>
            </RiseNavigationDropdown>
            
        </ProfileSection>
        
    </RiseAppHeader>
    
    <Navigation />
    
    <main>
        <MudMainContent class="section">
            @Body
        </MudMainContent>
    </main>
</MudLayout>