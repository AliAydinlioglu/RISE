@using Rise.Client.Components
@inherits LayoutComponentBase

@* Required *@
<MudThemeProvider Theme="@MyCustomTheme"/>
<MudPopoverProvider/>
@* Needed for dialogs *@
<MudDialogProvider/>
@* Needed for snackbars *@
<MudSnackbarProvider/>

<MudLayout>
    <RiseAppHeader>
        <ProfileSection>
            <AuthorizeView>
                <NotAuthorized>
                    <MudMenu>
                        <ActivatorContent>
                            <MudAvatar Class="px-1 border-2  " Variant="Variant.Outlined" Color="Color.Secondary"
                                       @onclick="GoToLogin">
                                <MudIcon Icon="@Icons.Material.Filled.Login"/>
                            </MudAvatar>
                        </ActivatorContent>

                    </MudMenu>
                </NotAuthorized>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized>
                    <NotificationBell />
                    <MudMenu>
                        <ActivatorContent>
                            <MudAvatar Class="px-1 border-2" Variant="Variant.Outlined" Color="Color.Secondary">
                                <MudText Typo="Typo.body2">@UserInitials</MudText>
                            </MudAvatar>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem @onclick="GoToAccount" Label="Profiel"/>
                            <MudMenuItem @onclick="GoToAccountSettings" Label="Settings"/>
                            <MudMenuItem @onclick="LogoutAsync" Label="Logout"/>
                        </ChildContent>
                    </MudMenu>
                </Authorized>
            </AuthorizeView>
        </ProfileSection>
    </RiseAppHeader>
    <Navigation/>
    <main>
        <MudMainContent class="section">
            <OfflineBanner/>
            @Body
        </MudMainContent>
    </main>
</MudLayout>