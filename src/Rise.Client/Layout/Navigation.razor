@using Rise.Client.Components
<MudDrawer Class="is-hidden-mobile" ClipMode="DrawerClipMode.Always" Open="true" Color="Color.Primary" Style=" top: calc(var(--mud-appbar-height) + 16px);">
    <MudNavMenu Color="Color.Secondary">
        @foreach (var item in NavItems)
        {
            <MudNavLink Href="@item.Href" Match="NavLinkMatch.All" Icon="@item.Icon" IconColor="Color.Inherit">@item.Title</MudNavLink>
        }
        
    </MudNavMenu>
</MudDrawer>

<footer class="is-hidden-tablet justify-space-around container" >
    @foreach (var item in NavItems)
    {
        <ItemLink Href="@item.Href" Icon="@item.Icon">@item.Title</ItemLink>
    }
</footer>