@using Rise.Client.Components
@if (!IsHomePage())
{
    <MudDrawer Class="is-hidden-mobile" ClipMode="DrawerClipMode.Always" Open="true" Color="Color.Primary" Style=" top: calc(var(--mud-appbar-height) + 16px);">
        <MudNavMenu Color="Color.Tertiary">
            @foreach (var item in NavItems)
            {
                <MudNavLink Class="nav-link-custom"
                            Href="@item.Href"
                            Match="@GetNavLinkMatch(item.Href)"
                            Icon="@item.Icon"
                            IconColor="Color.Inherit">
                    @item.Title
                </MudNavLink>
            }

        </MudNavMenu>
    </MudDrawer>
}
<footer class="is-hidden-tablet justify-space-around container" >
    @foreach (var item in MobileNavItems)
    {
        <RiseItemLink
            Href="@item.Href"
            Icon="@item.Icon"
            IsActiveLink="@GetNavLinkMatch(item.Href)">
            @item.Title
        </RiseItemLink>
    }
</footer>