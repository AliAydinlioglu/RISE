@page "/"
@using Rise.Client.Components

<PageTitle>Rise - Home</PageTitle>

<section class="section">
    <div class="container">
        <div class="columns is-centered">
            <div class="column is-half has-text-centered">
                <h1 class="title is-1 has-text-black">Rise</h1>
                <h2 class="subtitle is-3 has-text-grey-dark">Campus App</h2>

                <div class="box has-background-black has-text-white mt-5">
                    <h3 class="title is-4 has-text-white">In Ontwikkeling</h3>
                </div>
              
                <MudButton Variant="Variant.Filled" Color="Color.Primary">Default</MudButton>
            </div>
        </div>
        <MudGrid>
            @foreach(var item in NavItems)
            {
                <MudItem  xs="6" sm="6" md="4" lg="2">
                    <HomeBlock Href="@item.Href" Icon="@item.Icon" >@item.Title</HomeBlock>
                </MudItem>
            }
        </MudGrid>
    </div>
    
</section>