@page "/lessen/{CourseId}"
@using Rise.Client.Courses.Components

@if (_isLoading)
{
    <RiseLoader/>
}
else
{
    <MudContainer Class="py-4 px-6">
        <MudGrid Spacing="12">
            <MudItem xs="12" lg="3" Class="order-0 order-lg-2">
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudText Typo="Typo.h2" Class="mb-4 font-weight-bold">Lesinfo</MudText>
                </MudHidden>
                <CourseDetailGeneralInfo Course="_course"/>
            </MudItem>
            
            <MudItem xs="12" lg="5" Class="order-1 order-lg-0">
                <CourseDetailVaknieuws Announcements="_course.Announcements" />
            </MudItem>
            
            <MudItem xs="12" lg="4" Class="order-2 order-lg-1">
                <CourseDetailDeadlines Deadlines="_course.Deadlines" />
            </MudItem>
        </MudGrid>
    </MudContainer>
}