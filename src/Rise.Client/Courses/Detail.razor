@page "/lessen/{CourseId}"
@using Rise.Client.Courses.Components

@if (_isLoading)
{
    <RiseLoader/>
}
else
{
    <MudContainer Class="py-1 px-3">
        <MudGrid Spacing="6">
            <MudItem xs="12" md="5" lg="4">
                <MudPaper Elevation="0" Class="detail-section pa-4">
                    <MudText Typo="Typo.h2" Class="mb-4 font-weight-bold">Lesinfo</MudText>
                    <CourseDetailGeneralInfo Course="_course"/>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="7" lg="4">
                <MudPaper Elevation="0" Class="detail-section pa-4">
                    <CourseDetailVaknieuws Announcements="_course.Announcements"/>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="12" lg="4">
                <MudPaper Elevation="0" Class="detail-section pa-4">
                    <CourseDetailDeadlines Deadlines="_course.Deadlines"/>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>

    <MudContainer Class="py-4">
        <MudText Typo="Typo.h2" Class="mb-4 font-weight-bold">Vaknieuws</MudText>
        @if (_course.Announcements.Count == 0)
        {
            <RiseNotification Title="Geen vaknieuws beschikbaar" Severity="Info"/>
        }
        else
        {
            <MudStack Spacing="3">
                @foreach (var announcement in _course.Announcements)
                {
                    <MudPaper Class="pa-4" Elevation="1" Style="border-radius: 8px;">
                        <MudText Typo="Typo.h4" Class="mb-1">
                            @announcement.Title
                        </MudText>
                        <MudText Typo="Typo.caption" Style=@($"color: {Colors.Gray.Gray50}") Class="mb-3">
                            @announcement.Sender
                        </MudText>
                        <MudDivider Class="mb-3" Style=@($"background-color: {Colors.Gray.Gray50}")/>
                        <MudText Typo="Typo.body2" Class="text-justify">
                            @announcement.Message
                        </MudText>
                    </MudPaper>
                }
            </MudStack>
        }
    </MudContainer>

    <MudContainer Class="py-4">
        <MudText Typo="Typo.h2" Class="mb-4 font-weight-bold">Deadlines</MudText>
        @if (_course.Deadlines.Count == 0)
        {
            <RiseNotification Title="Geen deadlines beschikbaar" Severity="Info"/>
        }
        else
        {
            <MudStack Spacing="3">
                @foreach (var deadline in _course.Deadlines)
                {
                    <RiseCard Date="@deadline.Date"
                              Title="@deadline.Title"
                              Description="@deadline.Description"/>
                }
            </MudStack>
        }
    </MudContainer>
}