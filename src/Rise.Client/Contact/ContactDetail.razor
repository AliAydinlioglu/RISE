@page "/contact/{Id}"
@if (contactFacility == null)
{
    <MudContainer Class="mt-8">
        <RiseLoader />
    </MudContainer>
}
else
{
    <PageTitle>@contactFacility.Name</PageTitle>
    <a href="/contact" class="has-text-black hover:has-text-underline">
        <span class="icon">
            <i class="fas fa-arrow-left"></i>
        </span>
        <span>Terug naar contacten</span>
    </a>
    <div class="container ">
        <RiseHeadTitle>@contactFacility.Name</RiseHeadTitle>
    </div>

    <section class="mt-5 container">
        <div class="content">
            <div class="box" hidden="@string.IsNullOrWhiteSpace(contactFacility?.Description)">
                @contactFacility.Description
            </div>
            <div class="box" hidden="@((contactFacility.Location == null ? true : false))">
                <ContactLocation 
                    Location="contactFacility.Location"
                    ExtraInfo="@(ServiceContactHelper.ShowOpeningInfo(contactFacility.OpeningHours))">
                </ContactLocation>
            </div>
            <div class="box" hidden="@(!contactFacility?.CommunicationChannels?.Any() ?? true)">
                <ContactCommunication Channels="contactFacility.CommunicationChannels"></ContactCommunication>
            </div>
            <div class="box" hidden="@(!contactFacility?.OpeningHours?.Any() ?? true)">
                <ContactOpeningHours OpeningHours="contactFacility.OpeningHours"></ContactOpeningHours>
            </div>
            <div class="box" hidden="@(!contactFacility?.Remarks?.Any() ?? true)">
                <ContactRemarks Remarks=contactFacility.Remarks></ContactRemarks>
            </div>
        </div>
    </section>
}