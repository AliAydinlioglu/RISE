@page "/contact"
@inject HttpClient Http
<PageTitle>Contact</PageTitle>
<div class="container ">
    <RiseHeadTitle>Contact</RiseHeadTitle>
</div>

<section class="mt-5 container">
    @if (contactServices == null)
    {
        <MudContainer Class="mt-8">
            <RiseLoader />
        </MudContainer>
    }
    else
    {
        <div class="is-flex columns is-multiline mb-4">
            @foreach (var contactService in contactServices)
            {
                <article data-bunit="sa-index" class="mb-4 column is-12-mobile is-6-tablet is-6-desktop ">
                    <a href="/contact/@contactService">
                        <RiseInfoCard Title="@contactService.Name">
                            <div class="columns">
                                <div class="column">
                                    <ContactLocation 
                                        Location="contactService.Location"
                                        ExtraInfo="@(IsOpen(contactService.OpeningHours) ? " ✅ OPEN" : " ❌ GESLOTEN")">
                                    </ContactLocation>
                                    <br/>
                                    <ContactCommunication Channels="contactService.CommunicationChannels">
                                    </ContactCommunication>
                                </div>
                                <div class="column">
                                    <ContactOpeningHours OpeningHours="contactService.OpeningHours"></ContactOpeningHours>
                                    <br/>
                                    <ContactRemarks Remarks=contactService.Remarks></ContactRemarks>
                                </div>
                            </div>
                        </RiseInfoCard>
                    </a>
                </article>
            
            }
        
        </div>
        @* <section class="section pagination-section"> 
        
            <nav class="pagination is-rounded is-centered" role="navigation">
                <button class="pagination-previous" 
                        disabled="@(currentPage <= 1)"
                        @onclick="() => OnPageChangedAsync(currentPage - 1)">
                    Previous
                </button>
                <button class="pagination-next" 
                        disabled="@(currentPage >= totalPages)"
                        @onclick="() => OnPageChangedAsync(currentPage + 1)">
                    Next
                </button>
                <ul class="pagination-list">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        var pageNumber = i;
                        <li>
                            <button class="pagination-link @(currentPage == pageNumber ? "is-current" : "")"
                                    @onclick="() => OnPageChangedAsync(pageNumber)">
                                @pageNumber
                            </button>
                        </li>
                    }
                </ul>
            </nav>
        </section> *@
        }
</section>
