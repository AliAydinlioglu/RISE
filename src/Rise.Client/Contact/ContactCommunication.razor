﻿
<div class="contact-communications">
    @foreach (var channel in Channels.Where(c => !string.IsNullOrWhiteSpace(c.Name)))
    {
        <div class="mb-2">
            <span class="icon-text">
                <span class="icon has-text-grey-light">
                    <i class="fas @GetIconForCommunicationType(channel.TypeOfCommunication)"></i>
                </span>
                <span>
                    <a href="@channel.Link" target="_blank" class="has-text-link">@channel.Name</a>
                </span>
            </span>
        </div>
    }
</div>

@code {

    private string GetIconForCommunicationType(string type)
    {
        return type switch
        {
            "Email" => "fa-envelope",
            "Phone" => "fa-phone",
            "Form" => "fa-external-link-alt",
            "SocialMedia" => "fa-share-alt",
            _ => "fa-link"
        };
    }

}
