<div class="contact-communications">
    @foreach (var channel in Channels.Where(c => !string.IsNullOrWhiteSpace(c.Name)))
    {
        <div class="channel">
            <span class="category">@channel.TypeOfCommunication</span>
            <a href="@channel.Link" target="_blank">@channel.Name</a>
        </div>
    }
</div>