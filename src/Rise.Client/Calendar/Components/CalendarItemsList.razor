<div class="calendar-events">
    @if (Items != null && Items.Any())
    {
        @foreach (var item in Items)
        {
            <RiseCard Date="@item.Date"
                      Title="@item.Title"
                      Description="@item.Description"
                      CardHeader="@item.Header" 
                      OnClickNavigateTo="@(AllowClickThrough ? $"/kalender/lessen/{item.CourseId}?datum={item.Date:yyyy-MM-dd}" : null)"
                      Scale="0.7"/>
        }
    }
    else
    {
        <div class="notification is-light">
            <p class="has-text-centered">@EmptyMessage</p>
        </div>
    }
</div>