{
  "ConnectionStrings": {
    "DatabaseConnection": "server=192.168.56.11;port=3306;database=campusappdb;user=admin;password=admin123;SslMode=none"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "EntityFrameworkCore.Triggered": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {TraceId}] {Message:lj} {NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log_.txt",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {TraceId}] {Message:lj} {NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "AllowedHosts": "*",

  "AllowedOrigins": [
    "http://localhost:4200",
    "http://192.168.56.10",
    "http://192.168.56.11",
    "http://192.168.56.12",
    "http://192.168.56.13"
  ],

